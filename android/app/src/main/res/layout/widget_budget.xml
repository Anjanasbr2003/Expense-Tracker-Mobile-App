<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_budget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_trend"
            android:contentDescription="Budget" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="BUDGET PULSE"
            android:textColor="#A3E635"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Remaining Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMAINING ALLOWANCE"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_budget_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 50,000"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_budget_month_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spent: Rs. 0.00"
            android:textColor="#86EFAC"
            android:textSize="10sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Status Pill -->
    <LinearLayout
        android:id="@+id/widget_budget_status_pill"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/widget_button_glass"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_budget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFE • ON TRACK"
            android:textColor="#A3E635"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
